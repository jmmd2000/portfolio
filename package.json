{
  "name": "portfolio",
  "private": true,
  "version": "0.26.0",
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "prepare": "svelte-kit sync && husky",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:unit": "vitest run --project client --project server",
    "test:integration": "NODE_ENV=test vitest run --project integration",
    "test:e2e": "NODE_ENV=test playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:wipe": "tsx scripts/db-wipe.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "reset-password": "tsx scripts/reset-password.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@inquirer/password": "5.2.2",
    "@lucide/svelte": "1.52.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.4",
    "@types/sanitize-html": "2.16.2",
    "@vitest/browser-playwright": "5.0.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "vitest-browser-svelte": "3.1.0"
  },
  "dependencies": {
    "@fontsource-variable/albert-sans": "5.3.0",
    "@fontsource-variable/big-shoulders-display": "5.3.0",
    "@fontsource/monaspace-neon": "5.3.0",
    "better-auth": "1.7.6",
    "dotenv": "18.0.4",
    "drizzle-orm": "0.45.3",
    "marked": "18.0.14",
    "postgres": "3.4.9",
    "sanitize-html": "2.17.7",
    "shiki": "4.4.3",
    "zod": "4.6.5"
  }
}
