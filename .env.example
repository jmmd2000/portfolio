# The password docker compose gives the database. Production builds DATABASE_URL from it.
# Locally docker-compose.override.yml sets the password, but compose still needs a value here.
POSTGRES_PASSWORD="portfolio"

# The app connects with DATABASE_URL. Migrations and the db scripts use DATABASE_URL_MIGRATE.
# Locally both point at the dev database from docker compose.
DATABASE_URL="postgres://portfolio:portfolio@localhost:5437/portfolio_dev"
DATABASE_URL_MIGRATE="postgres://portfolio:portfolio@localhost:5437/portfolio_dev"
DATABASE_URL_TEST_E2E="postgres://portfolio:portfolio@localhost:5437/portfolio_test_e2e"
DATABASE_URL_TEST="postgres://portfolio:portfolio@localhost:5437/portfolio_test"
# Signs the admin session cookie. At least 32 characters: generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""
# The site's own address: the dev server locally
BETTER_AUTH_URL="http://localhost:5173"
# Cloudflare R2 holds the site's images. Development uses its own bucket, never the production one.
# The endpoint is on the bucket's settings page. The keys come from an R2 API token with read and write access to that one bucket.
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="hosted-assets-dev"
# The bucket's public address: the r2.dev address for the dev bucket, https://assets.jamesmddoyle.com in production
ASSETS_URL=""
# Spotify shows what's playing in the Listening row. The ID and secret are on the app's page at developer.spotify.com.
# The refresh token lets the site read what's playing on your account: run `pnpm spotify-token` to get one and save it here.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REFRESH_TOKEN=""
# Production only. Where errors are reported: the DSN from the portfolio project in GlitchTip, and the environment name.
# docker-compose.yml passes them to the site as PUBLIC_GLITCHTIP_DSN and PUBLIC_GLITCHTIP_ENVIRONMENT. Leave both empty to turn error reporting off.
GLITCHTIP_DSN=""
GLITCHTIP_ENVIRONMENT=""
